# Copy to .env for local runs. Never commit .env.
# For the GitHub Copilot cloud agent, put these in the repo's `copilot` environment instead.

# --- LLM (any OpenAI-compatible API) ---
LLM_BASE_URL=
LLM_API_KEY=
# Use at least two model families. The skeptic, judge and cross-checker should differ from the reviewers.
REVIEWER_MODEL=
SKEPTIC_MODEL=
# JUDGE_MODEL may be the same as SKEPTIC_MODEL. GENERATOR_MODEL may be the same as REVIEWER_MODEL.
JUDGE_MODEL=
GENERATOR_MODEL=
# live | record | replay | off
LLM_MODE=live

# --- GitHub (only needed from phase 7) ---
# Fine-grained token for a throwaway test repository.
MERGEGUARD_GITHUB_TOKEN=
TEST_REPO=owner/name
# Only for webhook mode (optional)
MERGEGUARD_WEBHOOK_SECRET=

# --- App ---
DATABASE_PATH=data/mergeguard.db
PRIVACY_MODE=false
